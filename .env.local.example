# Copy this file to .env.local and fill in the values from your Supabase
# project: Project Settings -> API.

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-side only. Used by admin server actions (creating intern /
# viewer accounts) and the seed:users script. NEVER prefix this with
# NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
